---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Your Cart | Peak Defense Works"
  description="Review the items in your Peak Defense Works cart."
>
  <section class="mx-auto max-w-5xl px-6 py-10 lg:px-10">
    <h1 class="font-display text-3xl font-bold uppercase text-pdw-ink">Your Cart</h1>

    <div id="cart-empty" class="mt-10 hidden border border-pdw-border bg-pdw-offwhite p-10 text-center">
      <p class="font-display text-sm uppercase tracking-wide text-pdw-muted">Your cart is empty</p>
      <a
        href="/shop"
        class="mt-6 inline-block border border-pdw-tan bg-pdw-tan px-6 py-3 font-display text-sm uppercase tracking-wide text-pdw-ink transition-colors hover:bg-pdw-tan-dark"
      >
        Continue Shopping
      </a>
    </div>

    <div id="cart-content" class="mt-8 hidden grid gap-10 lg:grid-cols-3">
      <div id="cart-items" class="space-y-4 lg:col-span-2"></div>

      <div class="border border-pdw-border bg-pdw-offwhite p-6 lg:col-span-1">
        <h2 class="font-display text-sm uppercase tracking-wide text-pdw-tan-dark">Order Summary</h2>
        <div class="mt-4 flex items-center justify-between text-sm text-pdw-body">
          <span>Subtotal</span>
          <span id="cart-subtotal" class="font-display text-pdw-ink">$0.00</span>
        </div>

        <div class="mt-4">
          <p id="free-shipping-message" class="font-display text-xs uppercase tracking-wide text-pdw-tan-dark"></p>
          <div class="mt-2 h-1.5 w-full overflow-hidden bg-pdw-border">
            <div id="free-shipping-progress" class="h-full bg-pdw-tan transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>

        <p class="mt-3 text-xs text-pdw-muted">Tax is calculated at checkout.</p>

        <button
          type="button"
          disabled
          class="mt-6 w-full cursor-not-allowed border border-pdw-border px-6 py-3 font-display text-sm uppercase tracking-wide text-pdw-muted"
        >
          Checkout Coming Soon
        </button>
        <p class="mt-3 text-xs text-pdw-muted">
          We're setting up payment processing. Your cart is saved on this device — check back soon to complete your order.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { getCart, removeFromCart, setQty, getCartTotal, type CartItem } from "../lib/cart";

  const FREE_SHIPPING_THRESHOLD = 100;

  function formatPrice(value: number) {
    return `$${value.toFixed(2)}`;
  }

  function renderFreeShippingProgress(subtotal: number) {
    const messageEl = document.getElementById("free-shipping-message");
    const progressEl = document.getElementById("free-shipping-progress");
    if (!messageEl || !progressEl) return;

    const pct = Math.min(100, (subtotal / FREE_SHIPPING_THRESHOLD) * 100);
    progressEl.style.width = `${pct}%`;

    if (subtotal >= FREE_SHIPPING_THRESHOLD) {
      messageEl.textContent = "You've unlocked free shipping!";
    } else {
      const remaining = FREE_SHIPPING_THRESHOLD - subtotal;
      messageEl.textContent = `Add ${formatPrice(remaining)} more for free shipping`;
    }
  }

  function renderItem(item: CartItem): string {
    const productHref = `/products/${item.slug}`;
    const image = item.image
      ? `<img src="${item.image}" alt="${item.name}" class="h-full w-full object-cover" />`
      : `<div class="flex h-full w-full items-center justify-center text-[10px] uppercase tracking-wide text-pdw-muted">No Photo</div>`;

    return `
      <div class="flex gap-4 border border-pdw-border bg-pdw-white p-4" data-cart-row="${item.slug}">
        <a href="${productHref}" class="h-24 w-24 shrink-0 overflow-hidden bg-pdw-offwhite">${image}</a>
        <div class="flex flex-1 flex-col justify-between">
          <div class="flex items-start justify-between gap-3">
            <div>
              <a href="${productHref}" class="font-display text-sm font-semibold uppercase text-pdw-ink hover:text-pdw-tan-dark">${item.name}</a>
              <p class="mt-1 text-sm text-pdw-body">${formatPrice(item.price)} each</p>
            </div>
            <button type="button" class="remove-item text-xs uppercase tracking-wide text-pdw-muted hover:text-pdw-ink" data-slug="${item.slug}">
              Remove
            </button>
          </div>
          <div class="mt-3 flex items-center justify-between">
            <div class="flex items-center border border-pdw-border">
              <button type="button" class="qty-decrease px-3 py-1.5 text-pdw-ink hover:bg-pdw-offwhite" data-slug="${item.slug}" aria-label="Decrease quantity">&minus;</button>
              <span class="w-8 text-center font-display text-sm">${item.qty}</span>
              <button type="button" class="qty-increase px-3 py-1.5 text-pdw-ink hover:bg-pdw-offwhite" data-slug="${item.slug}" aria-label="Increase quantity">+</button>
            </div>
            <span class="font-display text-sm text-pdw-ink">${formatPrice(item.price * item.qty)}</span>
          </div>
        </div>
      </div>
    `;
  }

  function render() {
    const cart = getCart();
    const emptyEl = document.getElementById("cart-empty");
    const contentEl = document.getElementById("cart-content");
    const itemsEl = document.getElementById("cart-items");
    const subtotalEl = document.getElementById("cart-subtotal");
    if (!emptyEl || !contentEl || !itemsEl || !subtotalEl) return;

    if (cart.length === 0) {
      emptyEl.classList.remove("hidden");
      contentEl.classList.add("hidden");
      itemsEl.innerHTML = "";
      return;
    }

    emptyEl.classList.add("hidden");
    contentEl.classList.remove("hidden");
    itemsEl.innerHTML = cart.map(renderItem).join("");
    const subtotal = getCartTotal();
    subtotalEl.textContent = formatPrice(subtotal);
    renderFreeShippingProgress(subtotal);

    itemsEl.querySelectorAll<HTMLButtonElement>(".remove-item").forEach((button) => {
      button.addEventListener("click", () => {
        if (button.dataset.slug) removeFromCart(button.dataset.slug);
      });
    });
    itemsEl.querySelectorAll<HTMLButtonElement>(".qty-decrease").forEach((button) => {
      button.addEventListener("click", () => {
        const slug = button.dataset.slug;
        if (!slug) return;
        const current = cart.find((i) => i.slug === slug);
        if (current) setQty(slug, current.qty - 1);
      });
    });
    itemsEl.querySelectorAll<HTMLButtonElement>(".qty-increase").forEach((button) => {
      button.addEventListener("click", () => {
        const slug = button.dataset.slug;
        if (!slug) return;
        const current = cart.find((i) => i.slug === slug);
        if (current) setQty(slug, current.qty + 1);
      });
    });
  }

  render();
  window.addEventListener("cart:updated", render);
</script>
