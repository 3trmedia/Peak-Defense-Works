---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { products } from "../data/products";

const featured = products.filter((p) => p.featured);
const newest = products.slice(0, 8);
---

<Layout title="Home">
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-pdw-border bg-pdw-black">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-6 py-16 lg:grid-cols-2 lg:px-10 lg:py-24">
      <div>
        <p class="font-display text-sm uppercase tracking-[0.2em] text-pdw-copper">Utah Made. Range Tested.</p>
        <h1 class="mt-4 font-display text-4xl font-bold uppercase leading-tight text-pdw-cream sm:text-5xl lg:text-6xl">
          Chassis Systems Built for the <span class="text-pdw-copper">TX22</span>
        </h1>
        <p class="mt-6 max-w-lg text-pdw-muted">
          Peak Defense Works designs and machines custom chassis, braces, and accessories for the Taurus TX22,
          from the first MP7-style build on the platform to the small parts that make it shoot right.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/shop"
            class="border border-pdw-copper bg-pdw-copper px-6 py-3 font-display text-sm uppercase tracking-wide text-pdw-black transition-colors hover:bg-pdw-copper-hover"
          >
            Shop All Products
          </a>
          <a
            href="/about"
            class="border border-pdw-border px-6 py-3 font-display text-sm uppercase tracking-wide text-pdw-cream transition-colors hover:border-pdw-copper hover:text-pdw-copper"
          >
            Our Story
          </a>
        </div>
      </div>
      <div class="relative">
        <img
          src="/images/hero/raider-x-hero.jpg"
          alt="Peak Defense Works chassis system"
          class="w-full border border-pdw-border object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Category tiles -->
  <section class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
    <h2 class="font-display text-2xl font-bold uppercase tracking-wide text-pdw-cream">Shop by Category</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <a href="/shop#chassis" class="group relative flex h-56 items-end overflow-hidden border border-pdw-border">
        <img src="/images/products/tx7-mtn2-chassis.jpg" alt="Chassis systems" class="absolute inset-0 h-full w-full object-cover opacity-60 transition-opacity group-hover:opacity-80" />
        <div class="absolute inset-0 bg-gradient-to-t from-pdw-black via-pdw-black/20 to-transparent"></div>
        <p class="relative z-10 p-5 font-display text-xl uppercase tracking-wide text-pdw-cream">Chassis Systems</p>
      </a>
      <a href="/shop#accessories" class="group relative flex h-56 items-end overflow-hidden border border-pdw-border">
        <img src="/images/products/antimatter-optic-rail.jpg" alt="Accessories" class="absolute inset-0 h-full w-full object-cover opacity-60 transition-opacity group-hover:opacity-80" />
        <div class="absolute inset-0 bg-gradient-to-t from-pdw-black via-pdw-black/20 to-transparent"></div>
        <p class="relative z-10 p-5 font-display text-xl uppercase tracking-wide text-pdw-cream">Accessories</p>
      </a>
      <a href="/shop#soft-goods" class="group relative flex h-56 items-end overflow-hidden border border-pdw-border">
        <img src="/images/products/snakestaff-mag-pouch-quad.jpg" alt="Soft goods" class="absolute inset-0 h-full w-full object-cover opacity-60 transition-opacity group-hover:opacity-80" />
        <div class="absolute inset-0 bg-gradient-to-t from-pdw-black via-pdw-black/20 to-transparent"></div>
        <p class="relative z-10 p-5 font-display text-xl uppercase tracking-wide text-pdw-cream">Soft Goods</p>
      </a>
    </div>
  </section>

  <!-- Featured -->
  <section class="border-y border-pdw-border bg-pdw-charcoal">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
      <h2 class="font-display text-2xl font-bold uppercase tracking-wide text-pdw-cream">Flagship Builds</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {featured.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <!-- New products -->
  <section class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
    <div class="flex items-center justify-between">
      <h2 class="font-display text-2xl font-bold uppercase tracking-wide text-pdw-cream">New &amp; Notable</h2>
      <a href="/shop" class="font-display text-sm uppercase tracking-wide text-pdw-copper hover:text-pdw-cream">View All &rarr;</a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {newest.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <!-- Mission strip -->
  <section class="border-t border-pdw-border bg-pdw-charcoal">
    <div class="mx-auto grid max-w-7xl gap-8 px-6 py-14 lg:grid-cols-3 lg:px-10">
      <div>
        <p class="font-display text-lg uppercase tracking-wide text-pdw-copper">Designed &amp; Built in Utah</p>
        <p class="mt-2 text-sm text-pdw-muted">Every chassis is designed, machined, and quality-checked in-house before it ships.</p>
      </div>
      <div>
        <p class="font-display text-lg uppercase tracking-wide text-pdw-copper">Owner-Operated</p>
        <p class="mt-2 text-sm text-pdw-muted">No investors, no compromises. Sam owns the product and the IP outright.</p>
      </div>
      <div>
        <p class="font-display text-lg uppercase tracking-wide text-pdw-copper">Built for the Range</p>
        <p class="mt-2 text-sm text-pdw-muted">Every design is tested under real recoil before it becomes a product.</p>
      </div>
    </div>
  </section>
</Layout>
