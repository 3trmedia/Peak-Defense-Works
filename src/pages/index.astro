---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { products, useCases, useCaseImages } from "../data/products";

const featured = products.filter((p) => p.featured);
const newest = products.slice(0, 8);
const shopUseCases = useCases.filter((u) => u !== "All");
const useCaseSlug = (label: string) => label.toLowerCase().replace(/\s+/g, "-");
const useCaseCopy: Record<string, string> = {
  Tactical: "Chassis builds, grips, and parts for range and home defense setups.",
  Competition: "Precision rail systems, magwells, and triggers built for speed.",
  "Concealed Carry": "Holsters and compact carry gear for chassis-equipped pistols.",
};
---

<Layout title="Home">
  <!-- Hero -->
  <section class="relative flex min-h-[640px] items-center overflow-hidden bg-pdw-dark">
    <img
      src="/images/stock/tp-slider-hero.jpg"
      alt="Shooter posted up on a precision rifle"
      class="absolute inset-0 h-full w-full scale-110 object-cover object-[38%_62%]"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-pdw-dark via-pdw-dark/75 to-pdw-dark/30"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-pdw-dark via-transparent to-pdw-dark/60"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <p class="font-display text-sm uppercase tracking-[0.25em] text-pdw-tan">Built for New Shooters</p>
      <h1 class="mt-4 max-w-2xl font-display text-4xl font-bold uppercase leading-tight text-pdw-white sm:text-6xl">
        The $300 Pistol <span class="text-pdw-tan">That Shoots Like $3,000</span>
      </h1>
      <p class="mt-6 max-w-lg text-pdw-white/80">
        Peak Defense Works turns an affordable Taurus TX22 into a serious range build. Get the extreme shooting
        experience, folding brace and all, without the extreme price tag.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/shop"
          class="border border-pdw-tan bg-pdw-tan px-6 py-3 font-display text-sm uppercase tracking-wide text-pdw-ink transition-colors hover:bg-pdw-tan-dark"
        >
          Shop All Products
        </a>
        <a
          href="/about"
          class="border border-pdw-white/40 px-6 py-3 font-display text-sm uppercase tracking-wide text-pdw-white transition-colors hover:border-pdw-tan hover:text-pdw-tan"
        >
          Our Story
        </a>
      </div>
    </div>
  </section>

  <!-- PREVIEW: Hero Option 4 (bottom-left card + breach hallway photo) -->
  <!-- Ben is deciding between this and the hero above. Remove whichever loses once he picks. -->
  <section class="relative flex min-h-[640px] items-end overflow-hidden bg-pdw-dark">
    <span class="absolute right-6 top-6 z-10 border border-pdw-tan/60 bg-pdw-dark/80 px-3 py-1 font-display text-xs uppercase tracking-widest text-pdw-tan">
      Hero Option 4 (Preview)
    </span>
    <img
      src="/images/stock/breach-hallway-hero.jpg"
      alt="Team moving through a cleared building"
      class="absolute inset-0 h-full w-full scale-125 object-cover object-[58%_45%]"
    />
    <div class="relative mx-auto w-full max-w-7xl px-6 pb-10 pt-10 lg:px-10">
      <div class="max-w-lg border border-pdw-tan/30 bg-pdw-dark/75 p-6 backdrop-blur-sm sm:p-8">
        <p class="font-display text-sm uppercase tracking-[0.25em] text-pdw-tan">Built for New Shooters</p>
        <h1 class="mt-3 font-display text-3xl font-bold uppercase leading-tight text-pdw-white sm:text-5xl">
          The $300 Pistol <span class="text-pdw-tan">That Shoots Like $3,000</span>
        </h1>
        <p class="mt-4 text-sm text-pdw-white/85 sm:text-base">
          Peak Defense Works turns an affordable Taurus TX22 into a serious range build. Get the extreme shooting
          experience, folding brace and all, without the extreme price tag.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href="/shop" class="border border-pdw-tan bg-pdw-tan px-6 py-3 font-display text-sm uppercase tracking-wide text-pdw-ink transition-colors hover:bg-pdw-tan-dark">
            Shop All Products
          </a>
          <a href="/about" class="border border-pdw-white/50 px-6 py-3 font-display text-sm uppercase tracking-wide text-pdw-white transition-colors hover:border-pdw-tan hover:text-pdw-tan">
            Our Story
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Category triptych -->
  <section class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
    <h2 class="font-display text-2xl font-bold uppercase tracking-wide text-pdw-ink">Shop by Category</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <a href="/shop#chassis-rifle-kits" class="group relative flex h-64 items-end overflow-hidden">
        <img src="/images/products/tx7-mtn2-chassis.jpg" alt="Chassis &amp; rifle kits" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-pdw-ink/80 via-pdw-ink/10 to-transparent"></div>
        <p class="relative z-10 p-5 font-display text-xl uppercase tracking-wide text-pdw-white">Chassis &amp; Rifle Kits</p>
      </a>
      <a href="/shop#holsters-carry" class="group relative flex h-64 items-end overflow-hidden">
        <img src="/images/stock/desert-range.jpg" alt="Holsters &amp; carry" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-pdw-ink/80 via-pdw-ink/10 to-transparent"></div>
        <p class="relative z-10 p-5 font-display text-xl uppercase tracking-wide text-pdw-white">Holsters &amp; Carry</p>
      </a>
      <a href="/shop#parts-accessories" class="group relative flex h-64 items-end overflow-hidden">
        <img src="/images/products/antimatter-optic-rail.jpg" alt="Parts &amp; accessories" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-pdw-ink/80 via-pdw-ink/10 to-transparent"></div>
        <p class="relative z-10 p-5 font-display text-xl uppercase tracking-wide text-pdw-white">Parts &amp; Accessories</p>
      </a>
    </div>
  </section>

  <!-- Shop by use case -->
  <section class="bg-pdw-offwhite">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
      <p class="font-display text-sm uppercase tracking-[0.2em] text-pdw-tan-dark">Built for How You Shoot</p>
      <h2 class="mt-1 font-display text-2xl font-bold uppercase tracking-wide text-pdw-ink">Shop by Use Case</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {shopUseCases.map((useCase) => (
          <a href={`/shop#${useCaseSlug(useCase)}`} class="group relative flex h-64 items-end overflow-hidden">
            <img
              src={useCaseImages[useCase]}
              alt={useCase}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-pdw-ink/85 via-pdw-ink/20 to-transparent"></div>
            <div class="relative z-10 p-5">
              <p class="font-display text-xl uppercase tracking-wide text-pdw-white">{useCase}</p>
              <p class="mt-1 text-sm text-pdw-white/75">{useCaseCopy[useCase]}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bestsellers -->
  <section class="bg-pdw-white">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
      <div class="flex items-end justify-between">
        <div>
          <p class="font-display text-sm uppercase tracking-[0.2em] text-pdw-tan-dark">Flagship Builds</p>
          <h2 class="mt-1 font-display text-2xl font-bold uppercase tracking-wide text-pdw-ink">Bestsellers</h2>
        </div>
        <a href="/shop" class="hidden font-display text-sm uppercase tracking-wide text-pdw-tan-dark hover:text-pdw-ink sm:block">View All &rarr;</a>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {featured.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <!-- Split content: made in Utah -->
  <section class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="font-display text-sm uppercase tracking-[0.2em] text-pdw-tan-dark">How It's Built</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase leading-tight text-pdw-ink">
          3D Printed. Precision Machined. Utah Made.
        </h2>
        <p class="mt-4 text-pdw-body">
          Every chassis starts as a CAD file and ends on a shooter's TX22. We run our own print floor in central
          Utah, so the part that ships is the part we designed and tested ourselves, not a contract overseas run.
        </p>
        <p class="mt-4 text-pdw-body">
          Sam owns the product and the IP outright. No investors, no shortcuts on fit or finish.
        </p>
        <a
          href="/about"
          class="mt-6 inline-block border border-pdw-tan px-6 py-3 font-display text-sm uppercase tracking-wide text-pdw-ink transition-colors hover:bg-pdw-tan"
        >
          Read Our Story
        </a>
      </div>
      <div class="relative h-80 overflow-hidden lg:h-96">
        <img src="/images/products/tx7-mtn2-chassis.jpg" alt="TX22 chassis system" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Promo banner -->
  <section class="relative flex min-h-[360px] items-center overflow-hidden bg-pdw-dark">
    <img src="/images/stock/desert-range.jpg" alt="Range in the Utah desert" class="absolute inset-0 h-full w-full object-cover opacity-40" />
    <div class="absolute inset-0 bg-gradient-to-t from-pdw-dark via-pdw-dark/70 to-pdw-dark/30"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-16 text-center lg:px-10">
      <p class="font-display text-sm uppercase tracking-[0.25em] text-pdw-tan">First to Market</p>
      <h2 class="mt-3 font-display text-3xl font-bold uppercase text-pdw-white sm:text-4xl">
        The First MP7-Style Build for the TX22
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-pdw-white/80">
        Thousands shipped since launch. Built and range-tested in Utah, not just rendered in CAD.
      </p>
      <a
        href="/shop"
        class="mt-6 inline-block border border-pdw-tan bg-pdw-tan px-6 py-3 font-display text-sm uppercase tracking-wide text-pdw-ink transition-colors hover:bg-pdw-tan-dark"
      >
        Shop the Chassis
      </a>
    </div>
  </section>

  <!-- New products -->
  <section class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
    <div class="flex items-center justify-between">
      <h2 class="font-display text-2xl font-bold uppercase tracking-wide text-pdw-ink">New &amp; Notable</h2>
      <a href="/shop" class="font-display text-sm uppercase tracking-wide text-pdw-tan-dark hover:text-pdw-ink">View All &rarr;</a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {newest.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <!-- Why buy from us -->
  <section class="border-y border-pdw-border bg-pdw-offwhite">
    <div class="mx-auto grid max-w-7xl gap-8 px-6 py-14 sm:grid-cols-2 lg:grid-cols-4 lg:px-10">
      <div class="text-center">
        <p class="font-display text-lg uppercase tracking-wide text-pdw-tan-dark">Owner-Operated</p>
        <p class="mt-2 text-sm text-pdw-body">No investors, no compromises. Sam owns the product and IP outright.</p>
      </div>
      <div class="text-center">
        <p class="font-display text-lg uppercase tracking-wide text-pdw-tan-dark">Utah Made</p>
        <p class="mt-2 text-sm text-pdw-body">Designed, printed, and quality-checked in-house before it ships.</p>
      </div>
      <div class="text-center">
        <p class="font-display text-lg uppercase tracking-wide text-pdw-tan-dark">Range Tested</p>
        <p class="mt-2 text-sm text-pdw-body">Every design is run under real recoil before it becomes a product.</p>
      </div>
      <div class="text-center">
        <p class="font-display text-lg uppercase tracking-wide text-pdw-tan-dark">Direct Support</p>
        <p class="mt-2 text-sm text-pdw-body">Questions about fit or orders go straight to the team, not a call center.</p>
      </div>
    </div>
  </section>
</Layout>
