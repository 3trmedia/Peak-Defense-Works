---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
  <section class="border-b border-pdw-border bg-pdw-charcoal">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
      <p class="font-display text-sm uppercase tracking-[0.2em] text-pdw-copper">Get in Touch</p>
      <h1 class="mt-2 font-display text-3xl font-bold uppercase text-pdw-cream sm:text-4xl">Contact Peak Defense Works</h1>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 lg:px-10">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-xl font-bold uppercase text-pdw-cream">Send a Message</h2>
        <p class="mt-2 text-sm text-pdw-muted">
          Questions about fit, orders, or upcoming drops. We usually reply within a business day or two.
        </p>
        <form class="mt-8 space-y-4" onsubmit="return false">
          <div>
            <label class="font-display text-xs uppercase tracking-wide text-pdw-muted" for="name">Name</label>
            <input
              id="name"
              type="text"
              required
              class="mt-1 w-full border border-pdw-border bg-pdw-charcoal px-3 py-2 text-sm text-pdw-cream focus:border-pdw-copper focus:outline-none"
            />
          </div>
          <div>
            <label class="font-display text-xs uppercase tracking-wide text-pdw-muted" for="email">Email</label>
            <input
              id="email"
              type="email"
              required
              class="mt-1 w-full border border-pdw-border bg-pdw-charcoal px-3 py-2 text-sm text-pdw-cream focus:border-pdw-copper focus:outline-none"
            />
          </div>
          <div>
            <label class="font-display text-xs uppercase tracking-wide text-pdw-muted" for="message">Message</label>
            <textarea
              id="message"
              rows="5"
              required
              class="mt-1 w-full border border-pdw-border bg-pdw-charcoal px-3 py-2 text-sm text-pdw-cream focus:border-pdw-copper focus:outline-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="border border-pdw-copper bg-pdw-copper px-6 py-3 font-display text-sm uppercase tracking-wide text-pdw-black transition-colors hover:bg-pdw-copper-hover"
          >
            Send Message
          </button>
        </form>
      </div>

      <div class="space-y-8">
        <div class="border border-pdw-border bg-pdw-charcoal p-6">
          <h3 class="font-display text-sm uppercase tracking-wide text-pdw-copper">Email</h3>
          <p class="mt-2 text-sm text-pdw-muted">support@peakdefenseworks.com</p>
        </div>

        <div id="returns" class="border border-pdw-border bg-pdw-charcoal p-6">
          <h3 class="font-display text-sm uppercase tracking-wide text-pdw-copper">Shipping &amp; Returns</h3>
          <ul class="mt-3 space-y-2 text-sm text-pdw-muted">
            <li>Flat-rate shipping to the lower 48 states, calculated at checkout.</li>
            <li>Most orders leave the shop within 4 to 6 business days.</li>
            <li>Order issues or return requests are handled directly by email.</li>
          </ul>
        </div>

        <div class="border border-pdw-border bg-pdw-charcoal p-6">
          <h3 class="font-display text-sm uppercase tracking-wide text-pdw-copper">Based In</h3>
          <p class="mt-2 text-sm text-pdw-muted">Central Utah</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
