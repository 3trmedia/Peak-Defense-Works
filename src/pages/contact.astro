---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
  <section class="relative overflow-hidden bg-pdw-dark">
    <img
      src="/images/stock/desert-range.jpg"
      alt="Range in the Utah desert"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-pdw-dark via-pdw-dark/80 to-pdw-dark/50"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-16 lg:px-10">
      <p class="font-display text-sm uppercase tracking-[0.2em] text-pdw-tan">Get in Touch</p>
      <h1 class="mt-2 font-display text-3xl font-bold uppercase text-pdw-white sm:text-4xl">Contact Peak Defense Works</h1>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 lg:px-10">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-xl font-bold uppercase text-pdw-ink">Send a Message</h2>
        <p class="mt-2 text-sm text-pdw-body">
          Questions about fit, orders, or upcoming drops. We usually reply within a business day or two.
        </p>
        <form class="mt-8 space-y-4" onsubmit="return false">
          <div>
            <label class="font-display text-xs uppercase tracking-wide text-pdw-muted" for="name">Name</label>
            <input
              id="name"
              type="text"
              required
              class="mt-1 w-full border border-pdw-border bg-pdw-white px-3 py-2 text-sm text-pdw-ink focus:border-pdw-tan focus:outline-none"
            />
          </div>
          <div>
            <label class="font-display text-xs uppercase tracking-wide text-pdw-muted" for="email">Email</label>
            <input
              id="email"
              type="email"
              required
              class="mt-1 w-full border border-pdw-border bg-pdw-white px-3 py-2 text-sm text-pdw-ink focus:border-pdw-tan focus:outline-none"
            />
          </div>
          <div>
            <label class="font-display text-xs uppercase tracking-wide text-pdw-muted" for="message">Message</label>
            <textarea
              id="message"
              rows="5"
              required
              class="mt-1 w-full border border-pdw-border bg-pdw-white px-3 py-2 text-sm text-pdw-ink focus:border-pdw-tan focus:outline-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="border border-pdw-tan bg-pdw-tan px-6 py-3 font-display text-sm uppercase tracking-wide text-pdw-ink transition-colors hover:bg-pdw-tan-dark"
          >
            Send Message
          </button>
        </form>
      </div>

      <div class="space-y-8">
        <div class="border border-pdw-border bg-pdw-offwhite p-6">
          <h3 class="font-display text-sm uppercase tracking-wide text-pdw-tan-dark">Email</h3>
          <p class="mt-2 text-sm text-pdw-body">support@peakdefenseworks.com</p>
        </div>

        <div id="returns" class="border border-pdw-border bg-pdw-offwhite p-6">
          <h3 class="font-display text-sm uppercase tracking-wide text-pdw-tan-dark">Shipping &amp; Returns</h3>
          <ul class="mt-3 space-y-2 text-sm text-pdw-body">
            <li>Flat-rate shipping to the lower 48 states, calculated at checkout.</li>
            <li>Most orders leave the shop within 4 to 6 business days.</li>
            <li>Order issues or return requests are handled directly by email.</li>
          </ul>
        </div>

        <div class="border border-pdw-border bg-pdw-offwhite p-6">
          <h3 class="font-display text-sm uppercase tracking-wide text-pdw-tan-dark">Based In</h3>
          <p class="mt-2 text-sm text-pdw-body">Central Utah</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
