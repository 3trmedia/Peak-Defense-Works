---
const navItems = [
  { label: "Home", href: "/" },
  { label: "Shop", href: "/shop" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];
const currentPath = Astro.url.pathname;
---

<div class="bg-pdw-dark py-2 text-center">
  <p class="font-display text-xs uppercase tracking-widest text-pdw-tan">
    Utah Designed &middot; Utah Made &middot; Ships Nationwide
  </p>
</div>

<header class="sticky top-0 z-50 border-b border-pdw-border bg-pdw-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4 lg:px-10">
    <a href="/" class="shrink-0 font-display text-xl font-bold uppercase tracking-widest">
      <span class="text-pdw-ink">[PDW]</span> <span class="text-pdw-tan-dark">Peak Defense Works</span>
    </a>

    <div class="hidden flex-1 items-center lg:flex">
      <div class="relative w-full max-w-sm">
        <input
          type="search"
          placeholder="Search products..."
          class="w-full border border-pdw-border bg-pdw-offwhite px-4 py-2 pr-10 text-sm text-pdw-ink placeholder:text-pdw-muted focus:border-pdw-tan focus:outline-none"
        />
        <svg xmlns="http://www.w3.org/2000/svg" class="absolute right-3 top-2.5 h-4 w-4 text-pdw-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0a7 7 0 10-9.9-9.9 7 7 0 009.9 9.9z" />
        </svg>
      </div>
    </div>

    <nav class="hidden items-center gap-7 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "font-display text-sm uppercase tracking-wide transition-colors",
            currentPath === item.href ? "text-pdw-tan-dark" : "text-pdw-ink hover:text-pdw-tan-dark",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-4">
      <a href="/shop" class="hidden text-pdw-ink hover:text-pdw-tan-dark sm:block" aria-label="Cart">
        <span class="relative inline-block">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m-10 0a2 2 0 100 4 2 2 0 000-4zm10 0a2 2 0 100 4 2 2 0 000-4z" />
          </svg>
          <span class="absolute -right-2 -top-2 flex h-4 w-4 items-center justify-center rounded-full bg-pdw-tan-dark text-[10px] text-pdw-white">0</span>
        </span>
      </a>
      <button
        id="mobile-menu-button"
        class="text-pdw-ink md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-pdw-border bg-pdw-white md:hidden">
    <nav class="flex flex-col gap-1 px-6 py-4">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "py-2 font-display text-sm uppercase tracking-wide",
            currentPath === item.href ? "text-pdw-tan-dark" : "text-pdw-ink",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  function initMobileMenu() {
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    if (!button || !menu) return;
    button.addEventListener("click", () => {
      const isHidden = menu.classList.contains("hidden");
      menu.classList.toggle("hidden");
      button.setAttribute("aria-expanded", String(isHidden));
    });
  }
  initMobileMenu();
</script>
