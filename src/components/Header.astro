---
import { products } from "../data/products";

const navItems = [
  { label: "Home", href: "/" },
  { label: "Shop", href: "/shop" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];
const currentPath = Astro.url.pathname;

// Minimal, always-current search index — pulled straight from products.ts
// at build time, so it never drifts as products are added or removed.
const searchIndex = products.map((p) => ({
  slug: p.slug,
  name: p.name,
  category: p.category,
  blurb: p.blurb,
  price: p.price,
  image: p.image ?? "",
}));
---

<div class="bg-pdw-dark py-2 text-center">
  <p class="font-display text-xs uppercase tracking-widest text-pdw-tan">
    Utah Designed &middot; Utah Made &middot; Ships Nationwide
  </p>
</div>

<header class="sticky top-0 z-50 border-b border-pdw-border bg-pdw-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-4 sm:gap-6 sm:px-6 lg:px-10">
    <a href="/" class="min-w-0 shrink truncate font-display text-base font-bold uppercase tracking-wide sm:text-xl sm:tracking-widest">
      <span class="text-pdw-ink">[PDW] </span><span class="text-pdw-tan-dark">Peak Defense Works</span>
    </a>

    <div class="hidden flex-1 items-center justify-center lg:flex">
      <div class="site-search-container relative w-full max-w-sm">
        <input
          type="search"
          placeholder="Search products..."
          autocomplete="off"
          class="site-search-input w-full border border-pdw-border bg-pdw-offwhite px-4 py-2 pr-10 text-sm text-pdw-ink placeholder:text-pdw-muted focus:border-pdw-tan focus:outline-none"
        />
        <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute right-3 top-2.5 h-4 w-4 text-pdw-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0a7 7 0 10-9.9-9.9 7 7 0 009.9 9.9z" />
        </svg>
        <div class="site-search-results absolute left-0 right-0 top-full z-50 mt-1 hidden max-h-96 overflow-y-auto border border-pdw-border bg-pdw-white shadow-lg"></div>
      </div>
    </div>

    <nav class="hidden items-center gap-7 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "font-display text-sm uppercase tracking-wide transition-colors",
            currentPath === item.href ? "text-pdw-tan-dark" : "text-pdw-ink hover:text-pdw-tan-dark",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-3 sm:gap-4">
      <a href="/cart" class="text-pdw-ink hover:text-pdw-tan-dark" aria-label="Cart">
        <span class="relative inline-block">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m-10 0a2 2 0 100 4 2 2 0 000-4zm10 0a2 2 0 100 4 2 2 0 000-4z" />
          </svg>
          <span id="cart-count-badge" class="absolute -right-2 -top-2 flex h-4 w-4 items-center justify-center rounded-full bg-pdw-tan-dark text-[10px] text-pdw-white">0</span>
        </span>
      </a>
      <button
        id="mobile-menu-button"
        class="text-pdw-ink md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-pdw-border bg-pdw-white md:hidden">
    <div class="px-6 pt-4">
      <div class="site-search-container relative w-full">
        <input
          type="search"
          placeholder="Search products..."
          autocomplete="off"
          class="site-search-input w-full border border-pdw-border bg-pdw-offwhite px-4 py-2 pr-10 text-sm text-pdw-ink placeholder:text-pdw-muted focus:border-pdw-tan focus:outline-none"
        />
        <svg xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute right-3 top-2.5 h-4 w-4 text-pdw-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0a7 7 0 10-9.9-9.9 7 7 0 009.9 9.9z" />
        </svg>
        <div class="site-search-results absolute left-0 right-0 top-full z-50 mt-1 hidden max-h-72 overflow-y-auto border border-pdw-border bg-pdw-white shadow-lg"></div>
      </div>
    </div>
    <nav class="flex flex-col items-end gap-1 px-6 py-4 text-right">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "py-2 font-display text-sm uppercase tracking-wide",
            currentPath === item.href ? "text-pdw-tan-dark" : "text-pdw-ink",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script define:vars={{ searchIndex }}>
  function initSiteSearch() {
    function formatPrice(value) {
      return `$${Number(value).toFixed(2)}`;
    }

    function renderResults(container, query) {
      const resultsEl = container.querySelector(".site-search-results");
      const q = query.trim().toLowerCase();

      if (!q) {
        resultsEl.classList.add("hidden");
        resultsEl.innerHTML = "";
        return;
      }

      const matches = searchIndex
        .filter(
          (p) =>
            p.name.toLowerCase().includes(q) ||
            p.category.toLowerCase().includes(q) ||
            p.blurb.toLowerCase().includes(q)
        )
        .slice(0, 8);

      if (matches.length === 0) {
        resultsEl.innerHTML = `<p class="p-3 font-display text-xs uppercase tracking-wide text-pdw-muted">No products found</p>`;
      } else {
        resultsEl.innerHTML = matches
          .map(
            (p) => `
            <a href="/products/${p.slug}" class="flex items-center gap-3 border-b border-pdw-border p-3 last:border-b-0 hover:bg-pdw-offwhite">
              <div class="h-10 w-10 shrink-0 overflow-hidden bg-pdw-offwhite">
                ${p.image ? `<img src="${p.image}" alt="" class="h-full w-full object-cover" />` : ""}
              </div>
              <div class="min-w-0 flex-1">
                <p class="truncate font-display text-xs uppercase tracking-wide text-pdw-ink">${p.name}</p>
                <p class="text-xs text-pdw-muted">${formatPrice(p.price)}</p>
              </div>
            </a>
          `
          )
          .join("");
      }
      resultsEl.classList.remove("hidden");
    }

    document.querySelectorAll(".site-search-container").forEach((container) => {
      const input = container.querySelector(".site-search-input");
      if (!input || input.dataset.boundSearch) return;
      input.dataset.boundSearch = "true";

      input.addEventListener("input", () => renderResults(container, input.value));
      input.addEventListener("focus", () => {
        if (input.value.trim()) renderResults(container, input.value);
      });
      input.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          container.querySelector(".site-search-results")?.classList.add("hidden");
          input.blur();
        }
      });
    });

    document.addEventListener("click", (event) => {
      document.querySelectorAll(".site-search-container").forEach((container) => {
        if (!container.contains(event.target)) {
          container.querySelector(".site-search-results")?.classList.add("hidden");
        }
      });
    });
  }
  initSiteSearch();
</script>

<script>
  import { getCartCount } from "../lib/cart";

  function initMobileMenu() {
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    if (!button || !menu) return;
    button.addEventListener("click", () => {
      const isHidden = menu.classList.contains("hidden");
      menu.classList.toggle("hidden");
      button.setAttribute("aria-expanded", String(isHidden));
    });
  }
  initMobileMenu();

  function updateCartBadge() {
    const badge = document.getElementById("cart-count-badge");
    if (badge) badge.textContent = String(getCartCount());
  }
  updateCartBadge();
  window.addEventListener("cart:updated", updateCartBadge);
  window.addEventListener("storage", updateCartBadge);
</script>
