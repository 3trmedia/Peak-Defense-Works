---
const navItems = [
  { label: "Home", href: "/" },
  { label: "Shop", href: "/shop" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-pdw-border bg-pdw-black/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-10">
    <a href="/" class="font-display text-xl font-bold uppercase tracking-widest text-pdw-cream">
      Peak <span class="text-pdw-copper">Defense</span> Works
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "font-display text-sm uppercase tracking-wide transition-colors",
            currentPath === item.href ? "text-pdw-copper" : "text-pdw-muted hover:text-pdw-cream",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-4">
      <a
        href="/shop"
        class="hidden items-center gap-2 border border-pdw-border px-4 py-2 font-display text-sm uppercase tracking-wide text-pdw-cream transition-colors hover:border-pdw-copper hover:text-pdw-copper sm:flex"
      >
        Cart
        <span class="rounded-full bg-pdw-copper px-2 py-0.5 text-xs text-pdw-black">0</span>
      </a>
      <button
        id="mobile-menu-button"
        class="text-pdw-cream md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-pdw-border bg-pdw-black md:hidden">
    <nav class="flex flex-col gap-1 px-6 py-4">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "py-2 font-display text-sm uppercase tracking-wide",
            currentPath === item.href ? "text-pdw-copper" : "text-pdw-muted",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  function initMobileMenu() {
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    if (!button || !menu) return;
    button.addEventListener("click", () => {
      const isHidden = menu.classList.contains("hidden");
      menu.classList.toggle("hidden");
      button.setAttribute("aria-expanded", String(isHidden));
    });
  }
  initMobileMenu();
</script>
