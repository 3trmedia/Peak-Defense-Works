---
import type { Product } from "../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;

const badgeText = product.status === "coming-soon" ? "In Development" : product.status === "sale" ? "Sale" : null;

const badgeClasses =
  product.status === "sale"
    ? "bg-pdw-tan text-pdw-ink"
    : "bg-pdw-ink/85 text-pdw-white";
---

<div class="group flex flex-col border border-pdw-border bg-pdw-white transition-colors hover:border-pdw-tan">
  <a href={`/products/${product.slug}`} class="flex flex-1 flex-col">
    <div class="relative aspect-square overflow-hidden bg-pdw-offwhite">
      {badgeText && (
        <span class:list={["absolute left-3 top-3 z-10 px-2 py-1 font-display text-[11px] uppercase tracking-wide", badgeClasses]}>
          {badgeText}
        </span>
      )}
      {product.image ? (
        <img
          src={product.image}
          alt={product.name}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full flex-col items-center justify-center gap-2 text-pdw-muted">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M4 8h16M4 4h16v16H4V4z" />
          </svg>
          <span class="font-display text-[11px] uppercase tracking-wide">Photo Coming Soon</span>
        </div>
      )}
    </div>
    <div class="flex flex-1 flex-col gap-2 p-4 pb-3">
      <p class="font-display text-[11px] uppercase tracking-widest text-pdw-tan-dark">{product.category}</p>
      <h3 class="font-display text-base font-semibold uppercase leading-snug text-pdw-ink">{product.name}</h3>
      <p class="line-clamp-2 text-sm text-pdw-body">{product.blurb}</p>
    </div>
  </a>
  <div class="flex items-center justify-between gap-2 px-4 pb-4">
    <div class="flex items-baseline gap-2">
      {product.price > 0 ? (
        <span class="font-display text-lg text-pdw-ink">${product.price.toFixed(2)}</span>
      ) : (
        <span class="font-display text-sm uppercase tracking-wide text-pdw-muted">TBD</span>
      )}
      {product.compareAt && (
        <span class="text-sm text-pdw-muted line-through">${product.compareAt.toFixed(2)}</span>
      )}
    </div>
    <button
      type="button"
      disabled={product.status === "coming-soon"}
      class:list={[
        "add-to-cart-button whitespace-nowrap font-display text-xs uppercase tracking-wide px-3 py-2 transition-colors",
        product.status === "coming-soon"
          ? "cursor-not-allowed border border-pdw-border text-pdw-muted"
          : "border border-pdw-tan text-pdw-ink hover:bg-pdw-tan hover:text-pdw-ink",
      ]}
      data-product-slug={product.slug}
      data-product-name={product.name}
      data-product-price={product.price}
      data-product-image={product.image ?? ""}
    >
      {product.status === "coming-soon" ? (
        "Notify"
      ) : (
        <>
          <span class="sm:hidden">Add</span>
          <span class="hidden sm:inline">Add to Cart</span>
        </>
      )}
    </button>
  </div>
</div>

<script>
  import { addToCart } from "../lib/cart";

  function initAddToCartButtons() {
    document.querySelectorAll<HTMLButtonElement>(".add-to-cart-button:not([disabled])").forEach((button) => {
      if (button.dataset.boundAddToCart) return;
      button.dataset.boundAddToCart = "true";
      button.addEventListener("click", () => {
        const { productSlug, productName, productPrice, productImage } = button.dataset;
        if (!productSlug || !productName) return;
        addToCart({
          slug: productSlug,
          name: productName,
          price: Number(productPrice) || 0,
          image: productImage || undefined,
        });
        const original = button.textContent;
        button.textContent = "Added!";
        button.disabled = true;
        setTimeout(() => {
          button.textContent = original;
          button.disabled = false;
        }, 1200);
      });
    });
  }
  initAddToCartButtons();
</script>
