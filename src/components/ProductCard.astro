---
import type { Product } from "../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;

const badgeText =
  product.status === "sold-out" ? "Sold Out" : product.status === "coming-soon" ? "Coming Soon" : product.status === "sale" ? "Sale" : null;

const badgeClasses =
  product.status === "sale"
    ? "bg-pdw-copper text-pdw-black"
    : "bg-pdw-charcoal text-pdw-muted border border-pdw-border";
---

<div class="group flex flex-col border border-pdw-border bg-pdw-charcoal transition-colors hover:border-pdw-copper/60">
  <div class="relative aspect-square overflow-hidden bg-pdw-surface">
    {badgeText && (
      <span class:list={["absolute left-3 top-3 z-10 px-2 py-1 font-display text-[11px] uppercase tracking-wide", badgeClasses]}>
        {badgeText}
      </span>
    )}
    <img
      src={product.image}
      alt={product.name}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <p class="font-display text-[11px] uppercase tracking-widest text-pdw-copper">{product.category}</p>
    <h3 class="font-display text-base font-semibold uppercase leading-snug text-pdw-cream">{product.name}</h3>
    <p class="line-clamp-2 text-sm text-pdw-muted">{product.blurb}</p>
    <div class="mt-auto flex items-center justify-between pt-3">
      <div class="flex items-baseline gap-2">
        <span class="font-display text-lg text-pdw-cream">${product.price.toFixed(2)}</span>
        {product.compareAt && (
          <span class="text-sm text-pdw-muted line-through">${product.compareAt.toFixed(2)}</span>
        )}
      </div>
      <button
        disabled={product.status === "sold-out"}
        class:list={[
          "font-display text-xs uppercase tracking-wide px-3 py-2 transition-colors",
          product.status === "sold-out"
            ? "cursor-not-allowed border border-pdw-border text-pdw-muted"
            : "border border-pdw-copper text-pdw-copper hover:bg-pdw-copper hover:text-pdw-black",
        ]}
      >
        {product.status === "sold-out" ? "Sold Out" : product.status === "coming-soon" ? "Notify Me" : "Add to Cart"}
      </button>
    </div>
  </div>
</div>
