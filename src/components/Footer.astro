---
const year = new Date().getFullYear();
---

<section class="border-t border-pdw-dark-surface bg-pdw-dark">
  <div class="mx-auto max-w-5xl px-6 py-12 text-center sm:py-16 lg:px-10">
    <p class="font-display text-sm uppercase tracking-[0.2em] text-pdw-tan">Stay in the Loop</p>
    <h2 class="mt-3 font-display text-2xl font-bold uppercase text-pdw-white sm:text-3xl">Sign Up for New Product Drops</h2>
    <p class="mt-3 text-sm text-pdw-muted">Be first to know when the next chassis, finish, or accessory ships.</p>
    <form class="mx-auto mt-6 flex max-w-md" onsubmit="return false">
      <input
        type="email"
        required
        placeholder="Email address"
        class="w-full border border-pdw-dark-surface bg-pdw-dark-surface px-4 py-3 text-sm text-pdw-white placeholder:text-pdw-muted focus:border-pdw-tan focus:outline-none"
      />
      <button
        type="submit"
        class="shrink-0 border border-pdw-tan bg-pdw-tan px-6 py-3 font-display text-sm uppercase tracking-wide text-pdw-ink transition-colors hover:bg-pdw-tan-dark"
      >
        Join
      </button>
    </form>
  </div>
</section>

<footer class="bg-pdw-dark">
  <div class="mx-auto max-w-7xl px-6 py-10 sm:py-14 lg:px-10">
    <div class="grid grid-cols-2 gap-x-6 gap-y-8 border-t border-pdw-dark-surface pt-10 md:grid-cols-4 md:gap-10 md:pt-12">
      <div class="col-span-2 md:col-span-1">
        <p class="font-display text-lg font-bold uppercase tracking-widest text-pdw-white">
          Peak <span class="text-pdw-tan">Defense</span> Works
        </p>
        <p class="mt-3 max-w-xs text-sm text-pdw-muted">
          Custom chassis systems and accessories for the Taurus TX22, designed and 3D printed in Utah.
        </p>
        <div class="mt-4 flex flex-col gap-2">
          <a
            href="https://www.instagram.com/peakdefenseworks/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm text-pdw-muted hover:text-pdw-tan"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
            </svg>
            @peakdefenseworks
          </a>
          <a
            href="https://www.youtube.com/@peakdefenseworks"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm text-pdw-muted hover:text-pdw-tan"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
              <rect x="2.5" y="5.5" width="19" height="13" rx="3.5" />
              <path d="M10.5 9.5l4.5 2.5-4.5 2.5v-5z" fill="currentColor" stroke="none" />
            </svg>
            @peakdefenseworks
          </a>
        </div>
      </div>

      <div>
        <p class="font-display text-sm uppercase tracking-widest text-pdw-white">Shop</p>
        <ul class="mt-3 space-y-2 text-sm text-pdw-muted">
          <li><a href="/shop" class="hover:text-pdw-tan">All Products</a></li>
          <li><a href="/shop#chassis-rifle-kits" class="hover:text-pdw-tan">Chassis &amp; Rifle Kits</a></li>
          <li><a href="/shop#holsters-carry" class="hover:text-pdw-tan">Holsters &amp; Carry</a></li>
          <li><a href="/shop#parts-accessories" class="hover:text-pdw-tan">Parts &amp; Accessories</a></li>
        </ul>
      </div>

      <div>
        <p class="font-display text-sm uppercase tracking-widest text-pdw-white">Company</p>
        <ul class="mt-3 space-y-2 text-sm text-pdw-muted">
          <li><a href="/about" class="hover:text-pdw-tan">About Us</a></li>
          <li><a href="/contact" class="hover:text-pdw-tan">Contact</a></li>
          <li><a href="/contact#returns" class="hover:text-pdw-tan">Shipping &amp; Returns</a></li>
          <li><a href="/privacy-policy" class="hover:text-pdw-tan">Privacy Policy</a></li>
          <li><a href="/terms-and-conditions" class="hover:text-pdw-tan">Terms &amp; Conditions</a></li>
        </ul>
      </div>

      <div class="col-span-2 md:col-span-1">
        <p class="font-display text-sm uppercase tracking-widest text-pdw-white">Based In</p>
        <p class="mt-3 text-sm text-pdw-muted">Central Utah</p>
        <p class="mt-4 text-sm text-pdw-muted">support@peakdefenseworks.com</p>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-pdw-dark-surface pt-6 text-xs text-pdw-muted md:mt-12 md:flex-row">
      <p>&copy; {year} Peak Defense Works. All rights reserved.</p>
      <p>Demo storefront in progress. Built by Blackout Media.</p>
    </div>
  </div>
</footer>
